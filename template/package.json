{
  "name": "CHANGE-ME",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/rendiv-kit/node/patch-rendiv.mjs",
    "studio": "rendiv studio src/index.tsx",
    "compositions": "rendiv compositions src/index.tsx",
    "typecheck": "tsc --noEmit",
    "check": "node node_modules/rendiv-kit/node/checks/index.mjs && tsc --noEmit",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "sheet": "node node_modules/rendiv-kit/node/contact-sheet.mjs",
    "sweep": "node node_modules/rendiv-kit/node/sweep.mjs",
    "pdf": "rendiv-export pdf --stem CHANGE-ME",
    "pptx": "rendiv-export pptx-stills --stem CHANGE-ME",
    "pptx:video": "rendiv-export pptx-video --stem CHANGE-ME",
    "vga": "rendiv-vga"
  },
  "dependencies": {
    "@rendiv/bundler": "0.2.6",
    "@rendiv/cli": "0.2.6",
    "@rendiv/core": "0.2.6",
    "@rendiv/player": "0.2.6",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rendiv-kit": "github:simontaurus/rendiv-kit#v0.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
